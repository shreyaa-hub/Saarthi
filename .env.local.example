# Copy to .env.local and fill in. Never commit the filled-in file.
#
# The two NEXT_PUBLIC_ values are read at BUILD time as well as at run time,
# so on a hosting platform they must be set before the build runs, not just
# before the server starts. A build with them missing succeeds and then fails
# at runtime, which is a confusing way to find out.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic → console.anthropic.com. Only the AI insights panel needs this;
# everything else works without it.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 when unset.
ANTHROPIC_MODEL=
