# Copy to .env.local and fill in. Never commit the filled-in file.
#
# The two NEXT_PUBLIC_ values are read at BUILD time as well as at run time,
# so on a hosting platform they must be set before the build runs, not just
# before the server starts. A build with them missing succeeds and then fails
# at runtime, which is a confusing way to find out.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL — leave both blank to run without the AI feature.
#
# Only the clinician's AI insights panel uses these. With no key set, the
# panel's trigger is not rendered at all, so the product simply has one fewer
# feature rather than a button that fails when clicked. Adding a key later
# turns it back on with no code change.
ANTHROPIC_API_KEY=

# Defaults to claude-sonnet-5 when unset.
ANTHROPIC_MODEL=
